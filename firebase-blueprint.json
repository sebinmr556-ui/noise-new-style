{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile with unique username, display name, avatar, bio, and counts.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Primary key user ID (Auth UID)" },
        "userId": { "type": "string", "description": "Primary database user ID (matches uid)" },
        "username": { "type": "string", "description": "Unique username" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "avatar": { "type": "string", "description": "Avatar image URL or base64 data" },
        "photoURL": { "type": "string", "description": "Photo URL" },
        "bio": { "type": "string", "description": "Bio description" },
        "website": { "type": "string", "description": "User website link" },
        "followersCount": { "type": "number", "description": "Follower count" },
        "followingCount": { "type": "number", "description": "Following count" },
        "isVerified": { "type": "boolean", "description": "Verified status" },
        "isPrivate": { "type": "boolean", "description": "Private profile status" },
        "blockedUsers": { "type": "array", "description": "List of blocked user IDs" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["uid", "username", "displayName"]
    },
    "Post": {
      "title": "Post",
      "description": "A social media post with filtered image, caption, location, and likes.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Author user ID" },
        "username": { "type": "string", "description": "Author username" },
        "avatar": { "type": "string", "description": "Author avatar image URL" },
        "image": { "type": "string", "description": "Processed image URL or base64 data URL" },
        "caption": { "type": "string", "description": "Post caption" },
        "location": { "type": "string", "description": "Optional location" },
        "filter": { "type": "string", "description": "Filter preset used" },
        "likes": { "type": "number", "description": "Total like count" },
        "likedBy": { "type": "array", "description": "List of user IDs who liked" },
        "savedBy": { "type": "array", "description": "List of user IDs who saved" },
        "comments": { "type": "array", "description": "Post comments" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" }
      },
      "required": ["uid", "username", "image"]
    },
    "Story": {
      "title": "Story",
      "description": "Ephemeral 24-hour user story image or clip.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Author user ID" },
        "username": { "type": "string", "description": "Author username" },
        "avatar": { "type": "string", "description": "Author avatar URL" },
        "mediaUrl": { "type": "string", "description": "Story media data URL" },
        "caption": { "type": "string", "description": "Story caption" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp" }
      },
      "required": ["uid", "username", "mediaUrl"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Peer-to-peer direct message with text, attachments, reactions, and seenBy status array.",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string", "description": "Deterministic conversation key between participants" },
        "participants": { "type": "array", "description": "Array of participant user IDs" },
        "senderId": { "type": "string", "description": "UID of the message sender" },
        "senderUsername": { "type": "string", "description": "Username of sender" },
        "senderDisplayName": { "type": "string", "description": "Display name of sender" },
        "senderAvatar": { "type": "string", "description": "Avatar of sender" },
        "receiverId": { "type": "string", "description": "UID of the message recipient" },
        "receiverUsername": { "type": "string", "description": "Username of recipient" },
        "receiverDisplayName": { "type": "string", "description": "Display name of recipient" },
        "receiverAvatar": { "type": "string", "description": "Avatar of recipient" },
        "text": { "type": "string", "description": "Message content" },
        "image": { "type": "string", "description": "Optional image URL/data URL" },
        "voiceDuration": { "type": "string", "description": "Optional voice recording duration" },
        "reaction": { "type": "string", "description": "Optional reaction emoji" },
        "read": { "type": "boolean", "description": "Read status flag" },
        "seenBy": { "type": "array", "description": "List of user UIDs who opened/saw the message" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Firestore server timestamp" },
        "clientTimestamp": { "type": "number", "description": "Client millisecond timestamp" }
      },
      "required": ["participants", "senderId", "receiverId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered user accounts collection indexed by Auth UID"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Feed and profile posts collection"
    },
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "Stories tray collection"
    },
    "/direct_messages/{msgId}": {
      "schema": "DirectMessage",
      "description": "Direct message thread entries with seenBy indicator array"
    }
  }
}
