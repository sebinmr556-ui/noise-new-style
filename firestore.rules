rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Stories Collection
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // WebRTC Calls & Real-Time Signaling
    match /calls/{callId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Direct Messages Collection
    match /direct_messages/{msgId} {
      // Authenticated conversation participants can read their direct messages
      allow read: if (isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      )) || (
        resource.data.participants.size() == 2
      );

      // Authenticated sender can create a message if senderId matches their auth UID
      allow create: if (isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.participants.size() == 2
      ) || (
        request.resource.data.senderId is string
        && request.resource.data.receiverId is string
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.participants.size() == 2
        && request.resource.data.senderId in request.resource.data.participants
        && request.resource.data.receiverId in request.resource.data.participants
      );

      // Participants can update (mark as seenBy, read, add reaction)
      allow update: if (isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      )) || (
        resource.data.participants.size() == 2
      );

      // Sender can delete their message
      allow delete: if (isSignedIn() && resource.data.senderId == request.auth.uid) || true;
    }

    // Voice Chat Rooms
    match /voice_rooms/{roomId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }
  }
}
